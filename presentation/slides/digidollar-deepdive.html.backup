                                <h4>Transaction Type</h4>
                                <code class="text-gold" style="font-size: 1.2rem;">0x03000770</code>
                                <p class="text-muted mt-1" style="font-size: 0.85rem;">REDEEM type identifier</p>
                            </div>
                        </div>
                    </div>

                    <div class="tx-section animate-fade-in-up" style="transition-delay: 0.4s;">
                        <div class="tx-label">INPUTS</div>
                        <div class="tx-content">
                            <div class="tx-box token">
                                <h4>Input[0]: DD Token</h4>
                                <p style="margin: 0.5rem 0;">100 DD token UTXO</p>
                                <code class="text-muted" style="font-size: 0.8rem;">Simple key-path spend</code>
                                <p class="text-success mt-1" style="font-size: 0.85rem;">To be burned</p>
                            </div>
                            <div class="tx-box vault">
                                <h4>Input[1]: Collateral Vault</h4>

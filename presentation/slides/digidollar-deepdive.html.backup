<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DigiDollar Technical Deep-Dive</title>
    <link rel="stylesheet" href="css/presentation.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        /* Deep-dive specific styles */
        .time-indicator {
            position: fixed;
            top: 20px;
            left: 30px;
            font-size: 0.85rem;
            color: var(--text-muted);
            z-index: 1000;
        }

        /* Architecture diagram */
        .arch-diagram {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            width: 100%;
            max-width: 900px;
        }

        .arch-layer {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            background: var(--bg-card);
            border-radius: 12px;
            border-left: 4px solid var(--dgb-blue);
            transition: all 0.3s ease;
        }

        .arch-layer:hover {
            transform: translateX(10px);
            background: var(--bg-card-hover);
            box-shadow: var(--glow-blue);
        }

        .arch-layer-num {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--gradient-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            flex-shrink: 0;
        }

        .arch-layer-content {
            flex: 1;
        }

        .arch-layer-title {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .arch-layer-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Code block styling */
        .code-container {
            width: 100%;
            max-width: 900px;
            background: rgba(0, 0, 0, 0.6);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .code-header {
            background: rgba(0, 111, 187, 0.2);
            padding: 0.75rem 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--dgb-blue-light);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .code-body {
            padding: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            line-height: 1.7;
            overflow-x: auto;
        }

        .code-body .comment { color: #6A9955; }
        .code-body .keyword { color: #C586C0; }
        .code-body .type { color: #4EC9B0; }
        .code-body .string { color: #CE9178; }
        .code-body .number { color: #B5CEA8; }
        .code-body .function { color: #DCDCAA; }
        .code-body .variable { color: #9CDCFE; }

        /* Byte diagram */
        .byte-diagram {
            display: flex;
            gap: 2px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .byte-cell {
            padding: 0.5rem 0.75rem;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            text-align: center;
            min-width: 60px;
        }

        .byte-cell.highlight-blue {
            background: rgba(0, 111, 187, 0.3);
            border-color: var(--dgb-blue);
        }

        .byte-cell.highlight-gold {
            background: rgba(212, 175, 55, 0.3);
            border-color: var(--dd-gold);
        }

        .byte-cell.highlight-green {
            background: rgba(0, 200, 81, 0.3);
            border-color: var(--success);
        }

        .byte-label {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* Tier table */
        .tier-table {
            width: 100%;
            max-width: 1000px;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.95rem;
        }

        .tier-table th {
            background: rgba(0, 111, 187, 0.3);
            padding: 1rem;
            text-align: center;
            font-weight: 600;
            border-bottom: 2px solid var(--dgb-blue);
        }

        .tier-table td {
            padding: 0.75rem 1rem;
            text-align: center;
            background: var(--bg-card);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tier-table tr:hover td {
            background: var(--bg-card-hover);
        }

        .ratio-bar {
            height: 20px;
            background: var(--gradient-gold);
            border-radius: 4px;
            display: inline-block;
        }

        /* Flow visual */
        .tx-flow {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            max-width: 1000px;
        }

        .tx-section {
            display: flex;
            gap: 1rem;
            align-items: stretch;
        }

        .tx-label {
            width: 100px;
            padding: 1rem;
            background: var(--gradient-blue);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            flex-shrink: 0;
        }

        .tx-content {
            flex: 1;
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .tx-box {
            flex: 1;
            min-width: 200px;
            padding: 1rem;
            background: var(--bg-card);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tx-box h4 {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .tx-box.vault {
            border-color: var(--dd-gold);
            border-width: 2px;
        }

        .tx-box.token {
            border-color: var(--success);
            border-width: 2px;
        }

        /* Oracle visual */
        .oracle-flow {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            width: 100%;
        }

        .exchange-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.5rem;
        }

        .exchange-box {
            padding: 0.75rem;
            background: var(--bg-card);
            border-radius: 8px;
            text-align: center;
            font-size: 0.85rem;
        }

        .oracle-arrow {
            font-size: 2rem;
            color: var(--dd-gold);
        }

        .oracle-result {
            padding: 1.5rem;
            background: var(--gradient-gold);
            border-radius: 16px;
            color: #000;
            text-align: center;
            font-weight: 700;
        }

        /* Protection layers */
        .layer-stack {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            width: 100%;
            max-width: 800px;
        }

        .layer-bar {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.25rem;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .layer-bar:hover {
            transform: scale(1.02);
        }

        .layer-bar.layer-1 {
            background: linear-gradient(90deg, rgba(220, 53, 69, 0.3) 0%, rgba(220, 53, 69, 0.1) 100%);
            border: 1px solid rgba(220, 53, 69, 0.5);
        }

        .layer-bar.layer-2 {
            background: linear-gradient(90deg, rgba(255, 179, 0, 0.3) 0%, rgba(255, 179, 0, 0.1) 100%);
            border: 1px solid rgba(255, 179, 0, 0.5);
        }

        .layer-bar.layer-3 {
            background: linear-gradient(90deg, rgba(0, 111, 187, 0.3) 0%, rgba(0, 111, 187, 0.1) 100%);
            border: 1px solid rgba(0, 111, 187, 0.5);
        }

        .layer-bar.layer-4 {
            background: linear-gradient(90deg, rgba(0, 200, 81, 0.3) 0%, rgba(0, 200, 81, 0.1) 100%);
            border: 1px solid rgba(0, 200, 81, 0.5);
        }

        .layer-icon {
            font-size: 1.5rem;
            width: 50px;
            text-align: center;
        }

        .layer-info {
            flex: 1;
        }

        .layer-title {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .layer-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .layer-value {
            font-family: var(--font-mono);
            font-size: 1.25rem;
            font-weight: 700;
        }

        /* Stats grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            width: 100%;
            max-width: 1000px;
        }

        .stat-card {
            padding: 1.5rem;
            background: var(--bg-card);
            border-radius: 16px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-card-value {
            font-size: 2.5rem;
            font-weight: 800;
            background: var(--gradient-gold);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-card-label {
            color: var(--text-muted);
            margin-top: 0.5rem;
        }

        /* LUNA comparison */
        .comparison-row {
            display: grid;
            grid-template-columns: 1fr 200px 1fr;
            gap: 1rem;
            width: 100%;
            max-width: 1000px;
            align-items: center;
        }

        .comparison-bad {
            padding: 1.5rem;
            background: rgba(220, 53, 69, 0.1);
            border: 2px solid rgba(220, 53, 69, 0.3);
            border-radius: 16px;
            text-align: center;
        }

        .comparison-good {
            padding: 1.5rem;
            background: rgba(0, 200, 81, 0.1);
            border: 2px solid rgba(0, 200, 81, 0.3);
            border-radius: 16px;
            text-align: center;
        }

        .comparison-label {
            text-align: center;
            font-weight: 600;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="time-indicator">Technical Deep-Dive</div>

    <div class="presentation">

        <!-- SLIDE 1: Title -->
        <section class="slide slide--hero active">
            <div class="slide-content">
                <div class="animate-fade-in-up" style="margin-bottom: 1.5rem;">
                    <img src="images/DigiDollar.jpg" alt="DigiDollar" style="width: 140px; height: 140px; border-radius: 50%; box-shadow: 0 0 50px rgba(0, 111, 187, 0.5); animation: float 3s ease-in-out infinite;">
                </div>

                <span class="badge badge--gold animate-fade-in-up" style="transition-delay: 0.1s;">Technical Deep-Dive</span>

                <h1 class="slide-title animate-fade-in-up" style="transition-delay: 0.2s; font-size: clamp(2.5rem, 5vw, 4.5rem);">
                    DigiDollar: UTXO-Native Stablecoins
                </h1>

                <p class="slide-subtitle animate-fade-in-up" style="transition-delay: 0.2s;">
                    Complete Technical Architecture & Implementation Guide<br>
                    <span class="text-muted">From Transaction Encoding to Wallet Integration</span>
                </p>

                <div class="divider animate-fade-in-up" style="transition-delay: 0.3s;"></div>

                <div class="grid-4 mt-4" style="max-width: 900px;">
                    <div class="stat-box animate-fade-in-up" style="transition-delay: 0.4s;">
                        <div class="stat-value" style="font-size: 1.8rem;">5</div>
                        <div class="stat-label">TX Types</div>
                    </div>
                    <div class="stat-box animate-fade-in-up" style="transition-delay: 0.5s;">
                        <div class="stat-value" style="font-size: 1.8rem;">9</div>
                        <div class="stat-label">Collateral Tiers</div>
                    </div>
                    <div class="stat-box animate-fade-in-up" style="transition-delay: 0.6s;">
                        <div class="stat-value" style="font-size: 1.8rem;">24</div>
                        <div class="stat-label">RPC Commands</div>
                    </div>
                    <div class="stat-box animate-fade-in-up" style="transition-delay: 0.7s;">
                        <div class="stat-value" style="font-size: 1.8rem;">100%</div>
                        <div class="stat-label">Transparent</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SLIDE 2: Overview/Agenda -->
        <section class="slide slide--blue slide--compact">
            <div class="slide-content">
                <h2 class="slide-title--blue animate-fade-in-up" style="background: var(--gradient-blue); -webkit-background-clip: text; margin-bottom: 1rem;">Technical Deep-Dive Agenda</h2>
                <p class="slide-subtitle animate-fade-in-up" style="margin-bottom: 1.5rem;">Complete architectural walkthrough in 8 sections</p>

                <div class="card card--compact animate-fade-in-up" style="max-width: 900px; padding: 1.5rem 2rem; transition-delay: 0.1s;">
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 2rem; font-size: 0.95rem;">
                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">1.</span>
                            <div>
                                <strong>Transaction Version Encoding</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">0x0D1D0770 magic number & TX type embedding</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">2.</span>
                            <div>
                                <strong>5 Transaction Types</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">MINT, TRANSFER, REDEEM, PARTIAL, ERR</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">3.</span>
                            <div>
                                <strong>9-Tier Collateral Scale</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">1000% to 200% based on lock duration</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">4.</span>
                            <div>
                                <strong>Minting DigiDollars</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">P2TR + MAST + CLTV vault construction</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">5.</span>
                            <div>
                                <strong>Transferring DD Tokens</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">0-value UTXOs with Schnorr key-path spends</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">6.</span>
                            <div>
                                <strong>Redeeming Collateral</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">Normal vs ERR paths, MAST script unlocking</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">7.</span>
                            <div>
                                <strong>Protection Systems</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">DCA (1.0-2.0x), ERR (80-95%), Volatility Freeze</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">8.</span>
                            <div>
                                <strong>UTXO Tracking & Transparency</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">Network-wide indexing, real-time statistics</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">9.</span>
                            <div>
                                <strong>Oracle System</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">Phase 1 (1-of-1) vs Phase 2 (8-of-15 multisig)</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">10.</span>
                            <div>
                                <strong>RPC Commands (24 total)</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">Developer APIs for integration & monitoring</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">11.</span>
                            <div>
                                <strong>Qt Wallet Walkthrough</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">User interface for minting, sending, redeeming</div>
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.75rem; align-items: start;">
                            <span style="color: var(--dgb-blue); font-weight: 700; min-width: 24px;">12.</span>
                            <div>
                                <strong>Test Coverage & Verification</strong>
                                <div class="text-muted" style="font-size: 0.85rem;">409 unit tests, 18 functional tests (85% complete)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glow-box mt-3 animate-fade-in-up" style="transition-delay: 0.2s; max-width: 900px; text-align: center; padding: 0.75rem 1.5rem;">
                    <strong>100% On-Chain, 100% Transparent, 100% UTXO-Native</strong>
                </div>
            </div>
        </section>

        <!-- SLIDE 3: Architecture Overview -->
        <section class="slide slide--blue">
            <div class="slide-content" style="padding-top: 100px; padding-bottom: 100px;">
                <h2 class="slide-title--blue animate-fade-in-up" style="background: var(--gradient-blue); -webkit-background-clip: text;">Five-Layer Architecture</h2>
                <p class="slide-subtitle animate-fade-in-up">Built natively on DigiByte's UTXO model</p>

                <div class="arch-diagram mt-4" style="max-width: 800px;">
                    <div class="arch-layer animate-fade-in-up" style="transition-delay: 0.1s;">
                        <div class="arch-layer-num">5</div>
                        <div class="arch-layer-content">
                            <div class="arch-layer-title">Application Layer</div>
                            <div class="arch-layer-desc">Qt Wallet UI + RPC API (24 commands) + DigiDollar Manager</div>
                        </div>
                    </div>

                    <div class="arch-layer animate-fade-in-up" style="transition-delay: 0.2s;">
                        <div class="arch-layer-num">4</div>
                        <div class="arch-layer-content">
                            <div class="arch-layer-title">Protection & Oracle Layer</div>
                            <div class="arch-layer-desc">DCA (1.0-2.0x), ERR (80-95%), Volatility Freeze + 7 Exchange Price Feeds</div>
                        </div>
                    </div>

                    <div class="arch-layer animate-fade-in-up" style="transition-delay: 0.3s;">
                        <div class="arch-layer-num">3</div>
                        <div class="arch-layer-content">
                            <div class="arch-layer-title">Consensus & Validation Layer</div>
                            <div class="arch-layer-desc">TX version validation (0x0D1D0770), UTXO tracking, Network-wide transparency</div>
                        </div>
                    </div>

                    <div class="arch-layer animate-fade-in-up" style="transition-delay: 0.4s;">
                        <div class="arch-layer-num">2</div>
                        <div class="arch-layer-content">
                            <div class="arch-layer-title">UTXO & Script Layer</div>
                            <div class="arch-layer-desc">P2TR outputs, MAST script trees, OP_RETURN metadata, Time-locked vaults</div>
                        </div>
                    </div>

                    <div class="arch-layer animate-fade-in-up" style="transition-delay: 0.5s;">
                        <div class="arch-layer-num">1</div>
                        <div class="arch-layer-content">
                            <div class="arch-layer-title">Cryptographic Foundation</div>
                            <div class="arch-layer-desc">Schnorr signatures (BIP-340), Taproot (BIP-341), CLTV time-locks (BIP-65)</div>
                        </div>
                    </div>
                </div>

                <div class="glow-box mt-4 animate-fade-in-up" style="transition-delay: 0.6s; max-width: 800px; text-align: center;">
                    <strong>Every layer is 100% on-chain</strong> - No off-chain dependencies or centralized servers
                </div>
            </div>
        </section>

        <!-- SLIDE 4: Transaction Version Encoding -->
        <section class="slide slide--gold slide--compact">
            <div class="slide-content">
                <h2 class="slide-title animate-fade-in-up">Transaction Version Encoding</h2>
                <p class="slide-subtitle animate-fade-in-up">Five transaction types identified by version field</p>

                <div class="grid-5 mt-4" style="max-width: 1100px; gap: 1rem;">
                    <div class="card text-center animate-fade-in-up" style="transition-delay: 0.1s; padding: 1.5rem 1rem;">
                        <code class="text-gold" style="font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">0x01000770</code>
                        <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">MINT</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Lock DGB<br>Create DD</div>
                    </div>
                    <div class="card text-center animate-fade-in-up" style="transition-delay: 0.2s; padding: 1.5rem 1rem;">
                        <code class="text-gold" style="font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">0x02000770</code>
                        <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">TRANSFER</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Send DD<br>Key-path</div>
                    </div>
                    <div class="card text-center animate-fade-in-up" style="transition-delay: 0.3s; padding: 1.5rem 1rem;">
                        <code class="text-gold" style="font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">0x03000770</code>
                        <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">REDEEM</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Full unlock<br>After CLTV</div>
                    </div>
                    <div class="card text-center animate-fade-in-up" style="transition-delay: 0.4s; padding: 1.5rem 1rem;">
                        <code class="text-gold" style="font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">0x04000770</code>
                        <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">PARTIAL</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Redeem some<br>Keep rest</div>
                    </div>
                    <div class="card text-center animate-fade-in-up" style="transition-delay: 0.5s; padding: 1.5rem 1rem;">
                        <code class="text-warning" style="font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">0x05000770</code>
                        <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">ERR</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Emergency<br>80-95%</div>
                    </div>
                </div>

                <div class="code-container mt-4 animate-fade-in-up" style="transition-delay: 0.6s;">
                    <div class="code-header">primitives/transaction.h</div>
                    <div class="code-body">
<span class="keyword">static const</span> <span class="type">int32_t</span> <span class="variable">DD_TX_VERSION</span> = <span class="number">0x0D1D0770</span>;

<span class="comment">// Version construction: (type &lt;&lt; 24) | 0x0770</span>
<span class="keyword">inline</span> <span class="type">int32_t</span> <span class="function">MakeDigiDollarVersion</span>(<span class="type">DigiDollarTxType</span> type) {
    <span class="keyword">return</span> (<span class="keyword">static_cast</span>&lt;<span class="type">int32_t</span>&gt;(type) &lt;&lt; <span class="number">24</span>) | (<span class="variable">DD_TX_VERSION</span> & <span class="number">0x0000FFFF</span>);
}
                    </div>
                </div>
            </div>

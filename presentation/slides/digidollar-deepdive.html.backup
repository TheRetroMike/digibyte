                            <div class="code-body" style="padding: 1rem; font-size: 0.85rem;">
<span class="comment">// Multi-input script-path</span>
<span class="keyword">Version:</span> <span class="number">0x03000770</span> <span class="comment">(REDEEM)</span>

<span class="keyword">Input[0]:</span> <span class="variable">DD token UTXO</span>
<span class="keyword">Input[1]:</span> <span class="variable">Collateral vault</span>
  <span class="comment">Script-path reveal</span>
  <span class="comment">CLTV satisfied</span>
  <span class="comment">Schnorr signature</span>

<span class="keyword">Output:</span> <span class="type">User DGB address</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tx-flow mt-4">
                    <div class="tx-section animate-fade-in-up" style="transition-delay: 0.3s;">
                        <div class="tx-label" style="background: var(--gradient-gold); color: #000;">VERSION</div>
                        <div class="tx-content">

                    <!-- Code: How It Works -->
                    <div class="animate-fade-in-up" style="transition-delay: 0.2s;">
                        <h3 class="text-blue mb-3" style="font-size: 1.2rem;">How It Works</h3>

                        <div class="code-container">
                            <div class="code-header">digidollar/health.cpp</div>
                            <div class="code-body" style="font-size: 0.85rem;">
<span class="function">ScanUTXOSet</span>() {
  <span class="comment">// Iterate ALL UTXOs</span>
  <span class="keyword">for each</span> <span class="variable">UTXO</span>:
    <span class="keyword">if</span> <span class="type">P2TR</span> + <span class="variable">vout</span>[<span class="number">0</span>] + <span class="variable">value</span> > <span class="number">0</span>:
      <span class="comment">// Found DD vault</span>
      Extract <span class="variable">DD amount</span> from <span class="type">OP_RETURN</span>
      <span class="variable">totalDD</span> += <span class="variable">ddAmount</span>
      <span class="variable">totalCollateral</span> += <span class="variable">collateral</span>
}
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: 1.5rem;">
                            <div class="card text-center" style="padding: 1rem;">
                                <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#127758;</div>
                                <div style="font-weight: 600; font-size: 0.9rem;">Blockchain-wide</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Scans entire UTXO set, not just wallet</div>
                            </div>
                            <div class="card text-center" style="padding: 1rem;">
                                <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#128200;</div>
                                <div style="font-weight: 600; font-size: 0.9rem;">Exact Amounts</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Reads DD amounts from OP_RETURN metadata</div>
                            </div>
                            <div class="card text-center" style="padding: 1rem;">
                                <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#9989;</div>
                                <div style="font-weight: 600; font-size: 0.9rem;">Consensus Compatible</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Read-only, all nodes get identical results</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glow-box mt-4 animate-fade-in-up" style="transition-delay: 0.3s; max-width: 800px; text-align: center;">
                    <strong>RPC Command:</strong> <code style="background: rgba(0,0,0,0.4); padding: 0.25rem 0.5rem; border-radius: 4px;">getdigidollarstats</code> returns network totals for system health
                </div>
